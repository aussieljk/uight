# The §20.2 matrix builds one output per base-path cell, and Playwright writes
# its own artefacts. `tests/e2e/.gitignore` lists these too; they are repeated
# here because the linter and formatter read the ROOT ignore file, and bundled
# output is neither ours to lint nor meaningful to format.
tests/e2e/fixture-app*/dist-*/
# Scratch copies of the fixture app, made per run for the specs that write to disk.
tests/e2e/fixture-app-hmr/
tests/e2e/fixture-app-perf/
tests/e2e/results/
tests/e2e/report/

# `uaight build`'s scaffold. It lives under node_modules/.uaight/ so a crashed
# build cannot leave anything in the working tree; this entry is kept only to
# clean up after a build from before that moved.
uaight-explorer.html
uaight-explorer.entry.js

# The docs site's generated half. `docs/scripts/sync.ts` copies the repository's
# own documents in and the built registry with them, so committing either would
# be committing a second copy that can go stale — which is the failure the sync
# script exists to prevent.
docs/reference/spec.md
docs/reference/architecture.md
docs/reference/roadmap.md
docs/reference/changelog.md
docs/public/
docs/.vitepress/dist/
docs/.vitepress/cache/
