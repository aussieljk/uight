{
	"name": "uaight",
	"version": "0.0.1-canary.0",
	"description": "A component explorer that runs inside your application's own Vite dev server.",
	"keywords": [
		"vite",
		"vite-plugin",
		"react",
		"component-explorer",
		"storybook",
		"fixtures",
		"design-system"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aussieljk/uaight.git",
		"directory": "packages/uaight"
	},
	"bugs": "https://github.com/aussieljk/uaight/issues",
	"homepage": "https://github.com/aussieljk/uaight#readme",
	"type": "module",
	"files": [
		"dist",
		"registry",
		"bin"
	],
	"bin": {
		"uaight": "bin/uaight.mjs",
		"uaight-mcp": "bin/uaight-mcp.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"import": "./dist/vite.js"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"import": "./dist/runtime.js"
		},
		"./chrome": {
			"types": "./dist/chrome.d.ts",
			"import": "./dist/chrome.js"
		},
		"./test": {
			"types": "./dist/test.d.ts",
			"import": "./dist/test.js"
		},
		"./mcp": {
			"types": "./dist/mcp.d.ts",
			"import": "./dist/mcp.js"
		},
		"./client": {
			"types": "./dist/client.d.ts"
		},
		"./styles.css": "./dist/styles.css"
	},
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"build": "bun run build:css && tsdown",
		"build:css": "bun run scripts/build-css.ts",
		"dev": "bun run build:css && tsdown --watch",
		"registry": "bun run scripts/build-registry.ts",
		"corpus": "bun run scripts/corpus.ts",
		"test": "vitest run",
		"prepublishOnly": "bun run version:check && bun run build && bun run test",
		"version:bump": "bun run scripts/version.ts --bump",
		"version:sync": "bun run scripts/version.ts --sync",
		"version:check": "bun run scripts/version.ts --check"
	},
	"dependencies": {
		"oxc-parser": "0.142.0",
		"tinyglobby": "0.2.17"
	},
	"peerDependencies": {
		"playwright": "^1.50 || ^2",
		"react": "^18 || ^19",
		"react-dom": "^18 || ^19",
		"vite": "^8.1"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		},
		"playwright": {
			"optional": true
		}
	},
	"devDependencies": {
		"@tailwindcss/cli": "4.3.3",
		"@types/node": "^26.1.2",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"react": "19.2.8",
		"react-docgen": "8.0.0",
		"react-dom": "19.2.8",
		"tailwindcss": "4.3.3",
		"tsdown": "0.22.14",
		"vite": "8.1.5",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=20.19.0"
	}
}
