{
	"name": "uaight-monorepo",
	"private": true,
	"type": "module",
	"workspaces": ["packages/*", "examples/*"],
	"scripts": {
		"build": "bun run --cwd packages/uaight build",
		"dev": "bun run --cwd packages/uaight dev",
		"demo": "bun run --cwd examples/frosted-ui dev",
		"test": "bun run --cwd packages/uaight test",
		"typecheck": "bun x tsc --noEmit -p packages/uaight/tsconfig.json",
		"lint": "bun x oxlint@1.76.0 .",
		"format": "bun x oxfmt@0.61.0 .",
		"verify": "bun run scripts/release.ts --dry-run",
		"release": "bun run scripts/release.ts"
	},
	"devDependencies": {
		"typescript": "7.0.2"
	},
	"engines": { "node": ">=20.19.0" }
}
