{
	"name": "uight-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"examples/*",
		"docs"
	],
	"scripts": {
		"build": "bun run --cwd packages/uight build",
		"dev": "bun run --cwd packages/uight dev",
		"demo": "bun run --cwd examples/ljkui dev",
		"docs": "bun run --cwd docs dev",
		"docs:build": "bun run --cwd docs build",
		"typecheck": "bun run build && bun run typecheck:only",
		"typecheck:only": "bun x tsc --noEmit -p packages/uight/tsconfig.json",
		"check": "bun run scripts/check.ts",
		"bench": "bun run scripts/bench.ts",
		"registry:resolve": "bun run scripts/registry-resolve.ts",
		"lint": "oxlint .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"knip": "knip",
		"verify": "bun run scripts/release.ts --dry-run",
		"release": "bun run scripts/release.ts"
	},
	"devDependencies": {
		"knip": "6.32.0",
		"oxfmt": "0.62.0",
		"oxlint": "1.77.0",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=20.19.0"
	}
}
